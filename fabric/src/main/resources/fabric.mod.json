{
  "schemaVersion": 1,
  "id": "orenocommons",
  "version": "${version}",
  "name": "Oreno Commons",
  "description": "Unify and add common code across mod loader.",
  "authors": [
    "mahmudindev"
  ],
  "contact": {
    "homepage": "https://github.com/mahmudindev",
    "sources": "https://github.com/mahmudindev/mcmod-orenocommons"
  },
  "license": "ARR",
  "icon": "assets/orenocommons/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.mahmudindev.mcmod.orenocommons.fabric.OrenoCommonsFabric"
    ],
    "client": [
      "com.github.mahmudindev.mcmod.orenocommons.fabric.client.OrenoCommonsFabricClient"
    ]
  },
  "mixins": [
    "orenocommons.mixins.json",
    "orenocommons-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
